<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/card">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false">
<TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="TODAY’S SPENDING" android:textColor="#D9F08B" android:textSize="11sp" android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/add" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/add" android:text="+" android:textSize="26sp" android:textColor="#123E35" android:contentDescription="@string/action_add_expense"/>
</LinearLayout>
<TextView android:id="@+id/today" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:layout_marginTop="2dp" android:gravity="center_vertical" android:text="৳ 0" android:textColor="#FFFDF4" android:textSize="34sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/month" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This month · ৳ 0.00" android:textColor="#B1C8BF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:max="100" android:progressTint="#D9F08B" android:progressBackgroundTint="#356054"/>
<TextView android:id="@+id/remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tap to set your budget" android:textColor="#D9F08B" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/allowance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Available today · ৳ 0.00" android:textColor="#B1C8BF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/pace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Offline · BDT" android:textColor="#D9F08B" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
<TextView android:id="@+id/addFood" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/chip" android:text="♧ Food" android:textColor="#E8F4C9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:contentDescription="@string/action_add_food"/>
<TextView android:id="@+id/addTransport" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/chip" android:text="↗ Transport" android:textColor="#E8F4C9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:contentDescription="@string/action_add_transport"/>
<TextView android:id="@+id/addGroceries" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/chip" android:text="▦ Groceries" android:textColor="#E8F4C9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:contentDescription="@string/action_add_groceries"/>
</LinearLayout>
<!-- Kept for the shared RemoteViews id set used by the compact layout. -->
<TextView android:id="@+id/check" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text=""/>
<TextView android:id="@+id/addAvailable" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text=""/>
</LinearLayout>
